{
  "id": "e2eb-flow-routed",
  "name": "e2eb routed",
  "state": "Draft",
  "enabled": true,
  "cron": "*/2 * * * *",
  "blocks": [
    {
      "id": "b1",
      "adapter": "http",
      "mode": "read",
      "name": "e2eb dummyjson users",
      "parentId": null,
      "serviceId": "svc-bm377j",
      "entity": null,
      "config": {
        "path": "/users",
        "responseFormat": "json",
        "recordPath": "$.users[*]",
        "split": true,
        "pagination": {"type": "none", "fields": {}}
      },
      "transforms": [
        {"id": "tr1", "kind": "extract", "config": {"attribute": "gender", "path": "$.gender"}},
        {"id": "tr2", "kind": "extract", "config": {"attribute": "age", "path": "$.age"}}
      ],
      "topicOverride": null
    },
    {
      "id": "b2",
      "adapter": "kafka",
      "mode": "write",
      "name": "e2eb female write",
      "parentId": "b1",
      "serviceId": null,
      "entity": "e2eb_female",
      "branch": {"name": "females", "match": "all", "rules": [
        {"field": "gender", "op": "equals", "value": "female"},
        {"field": "age", "op": "regex", "value": "^[23][0-9]$"}
      ]},
      "config": {},
      "transforms": [],
      "topicOverride": null
    },
    {
      "id": "b3",
      "adapter": "kafka",
      "mode": "write",
      "name": "e2eb male write",
      "parentId": "b1",
      "serviceId": null,
      "entity": "e2eb_male",
      "branch": {"name": "males", "match": "any", "rules": [
        {"field": "gender", "op": "equals", "value": "male"}
      ]},
      "config": {},
      "transforms": [],
      "topicOverride": null
    },
    {
      "id": "b4",
      "adapter": "kafka",
      "mode": "write",
      "name": "e2eb all write",
      "parentId": "b1",
      "serviceId": null,
      "entity": "e2eb_all",
      "branch": {"name": "everything"},
      "config": {},
      "transforms": [],
      "topicOverride": null
    }
  ],
  "topics": [],
  "variables": [],
  "servicePins": {}
}
